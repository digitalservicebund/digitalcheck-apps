fileignoreconfig:
  - filename: .github/workflows/pipeline.yml
    allowed_patterns:
      - secret-scan
      - "password: \\${{ secrets.GITHUB_TOKEN }}"
  - filename: .github/workflows/scan.yml
    allowed_patterns:
      - TRIVY_PASSWORD
  - filename: .env.example
    ignore_detectors: [filename]
  - filename: .env.test
    ignore_detectors: [filename]
  - filename: src/env.d.ts
    ignore_detectors: [filename]
  - filename: src/config/posthog.ts
    checksum: bfa6e5b573b6a00e9ca64d34be9c4cc9e35d91cf6753d751a3f4df7f334ea9c3
  - filename: src/utils/localStorageVersioned.ts
    allowed_patterns:
      - storageKey
  - filename: src/utils/localStorageVersioned.spec.ts
    allowed_patterns:
      - testKey
  - filename: src/pages/dokumentation/_react/DocumentationDataProvider.tsx
    allowed_patterns:
      - STORAGE_KEY
      - testKey
  - filename: src/pages/dokumentation/_react/DocumentationDataProvider.spec.tsx
    allowed_patterns:
      - STORAGE_KEY
  - filename: src/pages/vorpruefung/_react/preCheckDataService.ts
    allowed_patterns:
      - STORAGE_KEY
  - filename: src/resources/content/das-ist-neu.ts
    ignore_detectors: [filecontent]
  - filename: src/layouts/BeispieleLayout.astro # Google Forms link misinterpreted as base64
    ignore_detectors: [filecontent]
  - filename: src/resources/content/vorpruefung.ts # German text content misidentified as secret pattern
    ignore_detectors: [filecontent]
  - filename: src/resources/content/vorpruefung-ergebnis.ts # German text content misidentified as secret pattern
    checksum: 356e2177cff6c4579cbae0c4321d9d6e4752ba93bdf17fb7b7d99e105ff99cff
  - filename: public/documents/interview-leitfaden/Akteurlandschaft_Analyse.pptx # Power Point
    ignore_detectors: [filecontent]
  - filename: scripts/nkr-data/uv.lock # autogenerated lock file
    ignore_detectors: [filecontent]
  - filename: mise.lock # autogenerated lock file
    ignore_detectors: [filecontent]
  - filename: scripts/nkr-data/.env.example
    ignore_detectors: [filename]
  - filename: public/documents/BundeslaenderInfoPage.pdf
    checksum: b5034dcbaa91c8cddcb4d75843b211b4a4cea87fb78b64ad327705d1f91b25cf
  - filename: public/documents/Leitfaden_Digitalcheck_Bundesland_Aug2026.pdf
    checksum: d92731bd930d05095eb791d2dece358795e1a77cf0ff24cc9a1ad7a9be31c896
  - filename: nginx.template.conf
    allowed_patterns: [proxy_pass]
  - filename: src/pages/interoperabel/nationale-kontaktstelle/_content.ts
    ignore_detectors: [filename, filecontent] # German text content misidentified as secret pattern
  - filename: src/content/prinzipien/etablierte-technologien-ermoeglichen-effiziente-umsetzung.md
    ignore_detectors: [filecontent]
  - filename: src/utils/toc.ts
    checksum: c42cc97d54c05462c2ea418168ff32af5da6951e9d4cfe33af1518a29f44dca6
  - filename: src/assets/images/schulungen.jpg
    checksum: 42eef9612194e5bf28135106f58550a8be414fac545974d5e3e19aaf30e72960
  - filename: src/pages/bundeslaender/_assets/online-schulung.jpg
    checksum: 525cfda0c835c633ecb5560c74ea447ee07536edc22320dea71b5d618676a5ce
  - filename: src/assets/images/startseite-bundeslaender.png
    checksum: 8503a55d03d47d18d968a2243d3d85d015e584cdd6496c515e80033047f6dfa6
  - filename: src/pages/bundeslaender/_assets/angebot.png
    checksum: bdeda92c331ce4f129dea089d2853f1b100367ad86639e9dec1d2fc646e43237
  - filename: public/images/prozess-nationale-kontaktstelle.png
    checksum: 16edd1014115e3cdd0824566a1a9470dbd1e006d2b9774b8fb759337913ccedd
  - filename: src/assets/images/regelungsbegleitung.png
    checksum: 27bd925f90d37e2319f107d5f89c39da159281d6ac750b575a00044d165383e4
  - filename: src/assets/images/europa-karte.png
    checksum: 50db3636fffb722578351d3a4143955566e2ed90b8735907d64d67e260ae2014

allowed_patterns:
  - key
  - onKey
  - handleKey
  - cacheKey
  - CacheKey
  - passen
  - Anpassungen
  - Pass\s # Allow "Pass " followed by a space
  - \@[a-z0-9]{40} # Allow fixing action hashes
  - "secrets: inherit"
  - "key: \\${{ runner.os }}"
  - GITOPS_DIGITALCHECK_APP_PRIVATE_KEY
  - ARGOCD_PIPELINE_PASSWORD
  - "pass: true"
  - activeKey
  - getSelectedIndexByKey
  - https://ec.europa.eu/.* # URL misidentified as secret pattern
  - posthogKey
  - POSTHOG_KEY
  - firstKey
  - tabKey
  - btnKey

scopeconfig:
  - scope: node # ignores files such as package-lock.json
