{
  "name": "digitalcheck-dito",
  "private": true,
  "homepage": "https://digitalcheck.bund.de/",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "audit:licences": "license-checker-rseidelsohn --production --excludePrivatePackages --onlyAllow 'MIT;BSD-3-Clause;BSD-2-Clause;0BSD;ISC;Apache-2.0;MPL-2.0;BlueOak-1.0.0;Custom: LICENSE;Unlicense;Python-2.0;PSF-2.0;CC-BY-4.0;CC0-1.0;EUPL-1.2' --summary",
    "build": "astro build",
    "dev": "PUBLIC_STAGE=development pnpm astro dev",
    "dev:preview": "PUBLIC_STAGE=preview PREVIEW_BASE_PATH=/preview astro dev",
    "docker:build": "docker build -t digitalcheck-dito .",
    "docker:run": "docker run -d -p 8080:8080 --name digitalcheck-dito digitalcheck-dito:latest",
    "docker:stop": "docker stop digitalcheck-dito || true && docker rm digitalcheck-dito",
    "docker:dev": "pnpm run docker:build && pnpm run docker:run",
    "docker:logs": "docker logs -f digitalcheck-dito",
    "format": "prettier --check .",
    "format:fix": "pnpm run format:fix-selected .",
    "format:fix-selected": "prettier --write --ignore-unknown",
    "lint": "eslint --cache",
    "lint:fix": "eslint --cache --fix",
    "preinstall": "echo 'Please disable script execution for security reasons: pnpm install --ignore-scripts' && exit 1",
    "preview": "astro preview",
    "test": "vitest run",
    "test:a11y": "playwright test tests/a11y --config=tests/playwright.config.ts --project=\"Desktop Chrome\"",
    "test:a11y-nightly": "playwright test tests/a11y --config=tests/playwright-nightly.config.ts",
    "test:e2e": "NODE_OPTIONS='--trace-warnings' playwright test tests/e2e/ --config=tests/playwright.config.ts",
    "test:e2e-nightly": "playwright test tests/e2e/ --config=tests/playwright-nightly.config.ts",
    "test:snapshots": "playwright test tests/snapshots --config=tests/playwright-snapshots.config.ts",
    "test:update-snapshots": "playwright test tests/snapshots --config=tests/playwright-snapshots.config.ts --update-snapshots",
    "tests": "vitest run && pnpm run test:e2e && pnpm run test:a11y",
    "tests-nightly": "vitest run && pnpm run test:e2e-nightly && pnpm run test:a11y-nightly",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@astrojs/alpinejs": "^1.0.0",
    "@astrojs/mdx": "^8.1.1",
    "@astrojs/react": "^7.1.1",
    "@astrojs/sitemap": "^3.7.4",
    "@digitalservicebund/icons": "^2.1.0",
    "@headlessui/react": "^2.2.10",
    "@iconify-json/ic": "^1.2.4",
    "@kern-ux/native": "^2.8.2",
    "@nanostores/persistent": "^1.3.5",
    "@nanostores/react": "^2.0.1",
    "@rvf/react": "^8.1.4",
    "@rvf/zod": "^7.0.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/alpinejs": "^3.17.0",
    "alpinejs": "^3.17.5",
    "astro": "^7.4.2",
    "astro-route-generator": "github:digitalservicebund/astro-route-generator#0.2.7",
    "docx": "^9.13.0",
    "file-saver": "^2.0.5",
    "form-graph-engine": "github:digitalservicebund/form-graph-engine#v0.0.10",
    "marked": "^18.1.1",
    "nanostores": "^1.5.5",
    "posthog-js": "^1.438.15",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "unplugin-icons": "^24.0.0",
    "zod": "~4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@standard-schema/spec": "^1.1.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/file-saver": "^2.0.7",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.8",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-testing-library": "^7.16.2",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "license-checker-rseidelsohn": "^5.0.1",
    "mammoth": "^1.13.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "undici": "^8.12.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
