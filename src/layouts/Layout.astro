---
import Posthog from "@/components/global/Posthog.astro";
import "@/styles/globals.css";
import Footer from "@/layout/Footer.astro";
import PageHeader from "@/components/global/PageHeader.astro";
import { siteMeta } from "@/resources/content/shared/meta";
import { isProduction } from "@/config/stage";
import firaSansRegularUrl from "@kern-ux/native/dist/fonts/fira-sans/FiraSans-Regular.woff2?url";
import firaSansMediumUrl from "@kern-ux/native/dist/fonts/fira-sans/FiraSans-Medium.woff2?url";
import firaSansSemiBoldUrl from "@kern-ux/native/dist/fonts/fira-sans/FiraSans-SemiBold.woff2?url";
import {
  getRouteByPath,
  getRouteChain,
  hasVisibleChildren,
} from "@/utils/navigation/routeUtils";
import SectionSidebar from "@/components/global/SectionSidebar.astro";

interface Props {
  title?: string;
  description?: string;
  noMenu?: boolean;
}

const { title, description = siteMeta.description, noMenu } = Astro.props;

const pageTitle = title
  ? `${title} — ${siteMeta.siteName}`
  : siteMeta.titleWithTagline;

const canonicalUrl = Astro.url.href.replace(/\/$/, "");
const ogImage = `${Astro.url.origin}/images/og-image.png`;

const jsonLdMetadata = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteMeta.siteName,
  alternateName: siteMeta.alternateName,
  url: siteMeta.siteURL,
};

const currentRoute = getRouteByPath(Astro.url.pathname);
const [sectionRoot] = currentRoute ? getRouteChain(currentRoute) : [];
const showSectionSidebar =
  !!sectionRoot && hasVisibleChildren(sectionRoot) && !noMenu;
---

<!doctype html>
<html
  lang="de"
  class="scroll-smooth"
  transition:name="root"
  transition:animate="none"
  data-kern-theme="light"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta property="og:title" content={pageTitle} />
    <meta property="twitter:title" content={pageTitle} />

    <meta name="description" content={description} />
    <meta property="og:site_name" content={siteMeta.siteName} />
    <meta property="og:description" content={description} />
    <meta property="twitter:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="twitter:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <meta property="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonicalUrl} />
    <link
      rel="preload"
      href={firaSansRegularUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={firaSansMediumUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={firaSansSemiBoldUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon_32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon_64.png" type="image/png" sizes="64x64" />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(jsonLdMetadata)}
    ></script>
  </head>
  <body class="flex min-h-screen flex-col">
    <PageHeader />
    {showSectionSidebar ? (
      <div class="h-full min-[900px]:grid min-[900px]:grid-cols-[264px_minmax(0,1fr)]">
        <SectionSidebar />
        <div>
          <slot />
        </div>
      </div>
    ) : (
      <slot />
    )}
    <Footer />
    {isProduction && <Posthog />}
  </body>
</html>
