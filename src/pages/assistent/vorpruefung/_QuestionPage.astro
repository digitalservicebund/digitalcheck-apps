---
import RadioStepForm from "@/components/wizard/RadioStepForm";
import WizardButtonBar from "@/components/wizard/WizardButtonBar.astro";
import WizardLayout from "@/layouts/WizardLayout.astro";
import { assistent_vorpruefung } from "@/config/routes";
import { preCheck } from "@/resources/content/vorpruefung";
import { answerOptions } from "@/wizard/vorpruefungSchema";

interface Props {
  questionId: string;
  /** Heading of the page, labels the radio group */
  question: string;
}

const { questionId, question } = Astro.props;
const questionIdx = preCheck.questions.findIndex((q) => q.id === questionId);
const { title } = preCheck.questions[questionIdx];

const formId = "step-form";
const labelId = "question-label";
---

<!--
  Slots:
  - default: text below the question, e.g. "Praxisbeispiel"
  - hint: hint below the text, e.g. <DetailsSummary />
-->
<WizardLayout
  title={`Vorprüfung: ${title}`}
  pageNumber={questionIdx + 1}
  totalPages={preCheck.questions.length}
>
  <section class="space-y-32">
    <div class="space-y-16">
      <h1 id={labelId} class="kern-heading-large">
        {question}
      </h1>
      <slot />
      <slot name="hint" />
    </div>
    <RadioStepForm
      client:load
      formId={formId}
      labelledBy={labelId}
      options={answerOptions}
      wizardId="vorpruefung"
      name={questionId}
    />
  </section>
  <WizardButtonBar
    slot="button-bar"
    wizardId="vorpruefung"
    formId={formId}
    fallbackBackHref={assistent_vorpruefung.path}
  />
</WizardLayout>
