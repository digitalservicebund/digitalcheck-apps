---
import WizardButtonBar from "@/components/wizard/WizardButtonBar.astro";
import WizardLayout from "@/layouts/WizardLayout.astro";
import { getWizardSession } from "@/wizard/session";
import ResultTable from "./_ResultTable";

export const frontmatter = {
  title: "Ergebnis",
  sitemap: false,
};

const { steps } = getWizardSession("vorpruefung", Astro.url.pathname).progress;
---

<WizardLayout
  title={`Vorprüfung: ${frontmatter.title}`}
  pageNumber={steps.current}
  totalPages={steps.total}
  showProgressBar={false}
>
  <h1 class="kern-heading-large">{frontmatter.title}</h1>
  <section class="space-y-16">
    <h2 class="kern-heading-small">
      So kommt das Ergebnis zustande – jede Antwort einzeln korrigierbar:
    </h2>
    <ResultTable client:load />
  </section>
  <WizardButtonBar slot="button-bar" wizardId="vorpruefung" />
</WizardLayout>

<script>
  import { assistent_vorpruefung_ergebnis } from "@/config/routes";
  import { wizardStores } from "@/wizard/stores";

  // Only reachable once all questions are answered, e.g. not via a bookmark
  const { $isReachable, $resumePath } = wizardStores.vorpruefung;
  $isReachable.subscribe((isReachable) => {
    if (!isReachable(assistent_vorpruefung_ergebnis.path)) {
      globalThis.location.replace($resumePath.get());
    }
  });
</script>
