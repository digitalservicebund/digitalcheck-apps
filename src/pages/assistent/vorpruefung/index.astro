---
import { LinkButton } from "@/components/Button";
import Hero from "@/components/Hero.astro";
import Modal from "@/components/Modal.astro";
import Layout from "@/layouts/Layout.astro";
import { contact } from "@/resources/content/shared/contact";
import { vorpruefungFlow } from "@/wizard/vorpruefungFlow";
import IconMail from "~icons/ic/outline-mail";
import IconPhone from "~icons/ic/outline-phone";
import IconPublishedWithChanges from "~icons/ic/outline-published-with-changes";

export const frontmatter = {
  title: "Vorprüfung",
};

const faqItems = [
  {
    question: "Muss ich die Vorprüfung für jedes Vorhaben machen?",
    answer:
      "Es empfiehlt sich, die Vorprüfung für jedes Vorhaben zu machen. Falls Sie mehrere Regelungen haben, füllen Sie eine gemeinsame Vorprüfung für alle inhaltlich zusammenhängenden Regelungen eines Vorhabens aus. So viele wie nötig, so wenige wie möglich.",
  },
  {
    question:
      "Ich arbeite in einer Landesverwaltung – gilt die Vorprüfung für mich?",
    answer: "Ja, die Vorprüfung gilt auch für Länder.",
  },
  {
    question: "Was passiert mit dem Ergebnis?",
    answer: [
      "Für die Bundesebene: Das Ergebnis schicken Sie idealerweise als E-Mail an den Normenkontrollrat. Dafür stellen wir eine Vorlage bereit. Der NKR unterstützt Sie in Ihrem Regelungsvorhaben.",
      "Für die Länder: Das Ergebnis können Sie herunterladen und für Ihren Unterlagen verakten.",
    ],
  },
  {
    question: "Kann ich Antworten später ändern?",
    answer:
      "Sie können die Vorprüfung jederzeit beginnen und abbrechen – die Antworten werden automatisch gespeichert. Auch wenn Sie bereits ein Ergebnis erhalten haben, können Sie eine neue Vorprüfung starten.",
  },
];
---

<Layout title={frontmatter.title}>
  <main class="breakout-grid">
    <Hero class="space-y-24">
      <p class="kern-preline">Digitalbezug einschätzen</p>
      <h1>Vorprüfung</h1>

      <div class="space-y-8">
        <p>
          Finden Sie in 6 Fragen heraus, ob Sie in Ihrem Regelungsvorhaben
          Aspekte der digitalen Umsetzung und EU-Anforderungen an
          Interoperabilität beachten müssen.
        </p>
        <p>
          <b>Das brauchen Sie:</b>
        </p>
        <ul>
          <li>
            Eine grobe Vorstellung Ihre Regelvorhabens. Die Regelung sollte noch
            nicht geschrieben sein.
          </li>
          <li>Es werden keine weiteren Dokumente benötigt.</li>
        </ul>
      </div>
      <div class="space-y-8">
        <p>
          <b>Ergebnis:</b>
        </p>
        <ul>
          <li>Individueller Digital- und Interoperabilitätsbezug</li>
          <li>
            Ergebnis als E-Mail an Prüfstelle schicken oder als Dokumentation
            zur Selbstprüfung nutzen
          </li>
          <li>
            Chancen und Hindernisse der digitalen Umsetzung identifizieren
          </li>
        </ul>
      </div>

      <div class="kern-form-input max-w-400">
        <label class="kern-label" for="pruefbereich">
          Für welchen Bereich prüfen Sie?
        </label>
        <div class="kern-form-input__select-wrapper">
          <select class="kern-form-input__select" id="pruefbereich">
            <option value="bund" selected>
              Bund
            </option>
          </select>
        </div>
      </div>

      <!-- Hidden until the script below knows whether answers are stored -->
      <div class="flex items-center gap-24">
        <a
          class="kern-btn kern-btn--primary"
          href={vorpruefungFlow.initialPath}
          data-hidden-until-checked
          hidden
        >
          <span class="kern-label" data-show-if="no-answers-stored">
            Vorprüfung starten
          </span>
          <span class="kern-label" data-show-if="answers-stored" hidden>
            Vorprüfung fortsetzen
          </span>
          <span
            class="kern-icon kern-icon--arrow-forward"
            aria-hidden="true"
          ></span>
        </a>
        <button
          type="button"
          class="kern-btn kern-btn--tertiary"
          data-show-if="answers-stored"
          popovertarget="start-over-modal"
          hidden
        >
          <span class="kern-label">Neue Vorprüfung beginnen</span>
          <span
            class="kern-icon kern-icon--autorenew kern-icon--default"
            aria-hidden="true"
          ></span>
        </button>
        <Modal id="start-over-modal">
          <h2 slot="heading" class="kern-title kern-title--large mt-0">
            Neue Vorprüfung beginnen
          </h2>
          <p slot="body">
            Mit einer neuen Vorprüfung werden die Daten der begonnenen
            Vorprüfung gelöscht. Diese können nicht wiederhergestellt werden.
          </p>
          <button
            type="button"
            class="kern-btn kern-btn--secondary"
            popovertarget="start-over-modal"
            popovertargetaction="hide"
            slot="buttonLeft"
          >
            <span class="kern-label">Abbrechen</span>
          </button>
          <a
            class="kern-btn kern-btn--primary"
            href={vorpruefungFlow.initialPath}
            data-reset-wizard
            slot="buttonRight"
          >
            <span class="kern-label">Neu beginnen</span>
          </a>
        </Modal>
        <div
          class="flex items-center gap-8"
          data-show-if="no-answers-stored"
          hidden
        >
          <IconPublishedWithChanges
            class="size-22 shrink-0"
            aria-hidden="true"
          />
          <p class="kern-body kern-body--small py-0 text-feedback-loader">
            Keine Sorge, Ihre Daten werden automatisch im Browser gespeichert.
          </p>
        </div>
      </div>
    </Hero>

    <section class="space-y-16">
      <h2>Warum ist die Vorprüfung relevant für mein Vorhaben?</h2>
      <ul>
        <li>
          Sie erkennen Digitalisierungsbezug früh – bevor die Regelung
          geschrieben ist.
        </li>
        <li>Sie identifizieren EU-Anforderungen an Interoperabilität.</li>
      </ul>
      <p>
        Rechtliche Grundlage: § 4 Abs. 3 NKRG und die EU-Verordnung 2024/903
      </p>
    </section>

    <section class="space-y-16">
      <h2>Häufige Fragen</h2>
      <div>
        {faqItems.map((item) => (
          <details class="kern-accordion">
            <summary class="kern-accordion__header">
              <span class="kern-title">{item.question}</span>
            </summary>
            <div class="kern-accordion__body space-y-16">
              {(Array.isArray(item.answer) ? item.answer : [item.answer]).map(
                (paragraph) => (
                  <p class="kern-body">{paragraph}</p>
                ),
              )}
            </div>
          </details>
        ))}
        <details class="kern-accordion">
          <summary class="kern-accordion__header">
            <span class="kern-title">Werden meine Angaben gespeichert?</span>
          </summary>
          <div class="kern-accordion__body">
            <p class="kern-body">
              Ihre eingegebenen Daten werden unbegrenzt lange in der Sitzung
              gespeichert, bis
            </p>
            <ol class="kern-body list-[lower-alpha]">
              <li>Sie eine neue Vorprüfung starten, oder</li>
              <li>
                Ihr SINA-Rechner die Daten löscht (falls das bei Ihnen
                voreingestellt ist)
              </li>
            </ol>
          </div>
        </details>
      </div>
    </section>
    <section class="space-y-16">
      <p>Ihre Frage war nicht dabei? Kontaktieren Sie uns gerne:</p>
      <ul class="list-unstyled space-y-8">
        <li>
          <a class="kern-link items-center" href={contact.phone}>
            <IconPhone class="size-24" aria-hidden="true" />
            {contact.phoneDisplay}
          </a>
        </li>
        <li>
          <a class="kern-link items-center" href={`mailto:${contact.email}`}>
            <IconMail class="size-24" aria-hidden="true" />
            {contact.email}
          </a>
        </li>
      </ul>
    </section>
  </main>
</Layout>

<script>
  import { wizardStores } from "@/wizard/stores";

  const { $hasAnswers, reset } = wizardStores.vorpruefung;

  // Also updates when the answers change later, e.g. in another tab
  $hasAnswers.subscribe((hasAnswers) => {
    const visibleIf = hasAnswers ? "answers-stored" : "no-answers-stored";
    document
      .querySelectorAll<HTMLElement>("[data-show-if]")
      .forEach(
        (element) => (element.hidden = element.dataset.showIf !== visibleIf),
      );
  });

  // Buttons starts hidden until html is hydrated,
  // to avoid flashing the wrong state.
  document
    .querySelector<HTMLElement>("[data-hidden-until-checked]")
    ?.removeAttribute("hidden");

  // Clears the answers once the user confirms the dialog, before the link navigates to the first question
  document
    .querySelector("[data-reset-wizard]")
    ?.addEventListener("click", () => reset());
</script>
