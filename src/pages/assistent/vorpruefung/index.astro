---
import { LinkButton } from "@/components/Button";
import Hero from "@/components/Hero.astro";
import { assistent_vorpruefung_itSystem } from "@/config/routes";
import Layout from "@/layouts/Layout.astro";

export const frontmatter = {
  title: "Vorprüfung",
  navLabel: "Vorprüfung",
  sitemap: false,
};
---

<Layout title={frontmatter.title}>
  <main class="breakout-grid">
    <Hero>
      <h1>{frontmatter.title}</h1>
    </Hero>
    <section>
      <LinkButton
        href={assistent_vorpruefung_itSystem.path}
        iconLeft="kern-icon--arrow-forward"
      >
        Vorprüfung starten
      </LinkButton>
    </section>
  </main>
</Layout>
