---
import HelpButton from "@/components/HelpButton";
import HelpSection from "@/components/HelpSection.astro";
import KernBadge from "@/components/KernBadge.astro";
import RichText from "@/components/RichText";
import CheckboxPillsField from "@/components/wizard/CheckboxPillsField.astro";
import RadioField from "@/components/wizard/RadioField.astro";
import ShowIf from "@/components/wizard/ShowIf.astro";
import TextareaField from "@/components/wizard/TextareaField.astro";
import { prinzipien } from "@/config/routes";
import { getPrinzipienStaticPaths } from "@/content.config";
import { slugify } from "@/utils/utilFunctions";
import {
  prinzipAnswerOptions,
  prinzipFieldNames,
  prinzipSchema,
  toPrinzipOrder,
} from "@/wizard/dokumentationSchema";
import { stepFields } from "@/wizard/stepFields";
import StepPage from "./_StepPage.astro";

export const frontmatter = {
  sitemap: false,
};

export const getStaticPaths = getPrinzipienStaticPaths;

// props are generated by getStaticPaths
const { prinzip } = Astro.props;

const order = toPrinzipOrder(prinzip.order);
const names = prinzipFieldNames(order);
const fields = stepFields(prinzipSchema(order));
const answer = fields[names.antwort];

const schwerpunkteOptions = prinzip.Aspekte.map((aspekt) => ({
  value: slugify(aspekt.Kurzbezeichnung),
  label: aspekt.Kurzbezeichnung,
}));
---

<StepPage title={`Prinzip ${prinzip.order}: ${prinzip.Name}`}>
  <div class="space-y-48">
    <div class="space-y-8">
      <KernBadge variant={`prinzip-${prinzip.order}`} showIcon={false}>
        Prinzip {prinzip.order}
      </KernBadge>
      <h1 class="kern-heading-large">
        {prinzip.Name}
        <HelpButton client:load sectionId="prinzip" />
      </h1>
    </div>
    <div class="space-y-24">
      <h2 id={answer.labelId} class="kern-heading-medium">
        Schafft das Regelungsvorhaben die rechtlichen Voraussetzungen für die
        Umsetzung des Prinzips?
      </h2>
      <RadioField field={answer} options={prinzipAnswerOptions} />
    </div>
    <ShowIf field={answer} is={prinzipAnswerOptions.map(({ value }) => value)}>
      <div class="space-y-16">
        <ShowIf field={answer} is={["yes"]}>
          <div class="space-y-16 pb-16">
            <h2 class="kern-heading-medium">
              Erklären Sie, inwiefern Sie auf dieses Prinzip eingegangen sind
            </h2>
            <CheckboxPillsField
              field={fields[names.schwerpunkte]}
              options={schwerpunkteOptions}
              variant={`prinzip-${order}`}
            >
              Schwerpunkte auswählen
              <HelpButton client:load sectionId="schwerpunkte" />
            </CheckboxPillsField>
          </div>
        </ShowIf>
        <ShowIf field={answer} is={["no"]}>
          <h2 class="kern-heading-medium">
            Erklären Sie, warum das Prinzip nicht auf Ihr Vorhaben zutrifft
          </h2>
        </ShowIf>
        <ShowIf field={answer} is={["not-relevant"]}>
          <h2 class="kern-heading-medium">
            Erklären Sie, warum das Prinzip nicht relevant für Ihr Vorhaben ist
          </h2>
        </ShowIf>
        <TextareaField field={fields[names.erklaerung]} rows={4}>
          Erklärung
          <ShowIf slot="description" field={answer} is={["yes"]}>
            <RichText markdown={prinzip.Erklaerungshilfe} />
          </ShowIf>
        </TextareaField>
      </div>
    </ShowIf>
  </div>

  <HelpSection slot="help" id="prinzip" title={`Hinweis zu „${prinzip.Name}“`}>
    <RichText markdown={prinzip.Hilfetext} />
    <a href={`${prinzipien.path}/${prinzip.URLBezeichnung}`} class="kern-link">
      <span
        class="kern-icon kern-icon--arrow-forward"
        aria-hidden="true"
      ></span>
      Mehr zum Prinzip {prinzip.order}
    </a>
  </HelpSection>
  <HelpSection
    slot="help"
    id="schwerpunkte"
    title="Schwerpunkte dieses Prinzips"
  >
    <p>Wählen Sie aus, welche Schwerpunkte für Ihr Vorhaben relevant sind.</p>
    <p>
      Diese dienen Ihnen als roter Faden für Ihre Erklärung. So formulieren Sie
      präzise und stellen sicher, dass Ihre Regelung das Prinzip erfüllt.
    </p>
    <div>
      {prinzip.Aspekte.map((aspekt) => (
        <details class="kern-accordion">
          <summary class="kern-accordion__header">
            <span class="kern-title">{aspekt.Kurzbezeichnung}</span>
          </summary>
          <div class="kern-accordion__body">
            <RichText className="kern-body" markdown={aspekt.Text} />
          </div>
        </details>
      ))}
    </div>
  </HelpSection>
</StepPage>
