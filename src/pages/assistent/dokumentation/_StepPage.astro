---
import WizardButtonBar from "@/components/wizard/WizardButtonBar.astro";
import { assistent_dokumentation } from "@/config/routes";
import WizardLayout from "@/layouts/WizardLayout.astro";
import { getWizardSession } from "@/wizard/session";

interface Props {
  /** Short page title, used in the document title */
  title: string;
}

const { title } = Astro.props;

const session = getWizardSession("dokumentation", Astro.url.pathname);
const { steps } = session.progress;
---

<!--
  Shell shared by all Dokumentation steps, the content differs per step.
  Fields are plain markup (e.g. <RadioField />), wired to the store by bindStepForm.
  Answers are never required to continue, so "Weiter" always links to the next page.
  Slots:
  - default: step content (heading, text, fields)
  - help: <HelpSection />s shown in the help panel
-->
<WizardLayout
  title={`Dokumentation: ${title}`}
  pageNumber={steps.current}
  totalPages={steps.total}
>
  {session.pageSchema ? (
    <form
      class="space-y-kern-xl"
      novalidate
      data-wizard-step-form="dokumentation"
    >
      <slot />
    </form>
  ) : (
    <slot />
  )}
  <slot name="help" slot="help" />
  <WizardButtonBar
    slot="button-bar"
    wizardId="dokumentation"
    fallbackBackHref={assistent_dokumentation.path}
  />
</WizardLayout>

<script>
  import { bindStepForm } from "@/wizard/bindStepForm";
  import { wizardFields, type WizardId } from "@/wizard/session";
  import { wizardStores } from "@/wizard/stores";

  document
    .querySelectorAll<HTMLFormElement>("form[data-wizard-step-form]")
    .forEach((form) => {
      const wizardId = form.dataset.wizardStepForm as WizardId;
      bindStepForm(form, wizardStores[wizardId], wizardFields[wizardId]);
    });
</script>
