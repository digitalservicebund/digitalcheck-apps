---
import europeMap from "@/assets/images/europa-karte.png";
import HelpButton from "@/components/HelpButton.astro";
import HelpSection from "@/components/HelpSection.astro";
import RadioField from "@/components/wizard/RadioField.astro";
import { interopsAssessment } from "@/pages/interoperabel/_anchors";
import { linkToIEAArticle } from "@/pages/dokumentation/_react/interoperability/markdownLinkIEA";
import {
  euInteroperabilitaetOptions,
  euInteroperabilitaetSchema,
} from "@/wizard/dokumentationSchema";
import { stepFields } from "@/wizard/stepFields";
import { Image } from "astro:assets";
import StepPage from "../_StepPage.astro";

export const frontmatter = {
  title: "EU-Interoperabilität",
  sitemap: false,
  navOrder: 8,
};

const bezug = stepFields(euInteroperabilitaetSchema)[
  "eu-interoperabilitaet-bezug"
];
---

<StepPage title={frontmatter.title}>
  <div class="space-y-48">
    <!-- Decorative, the heading names the step -->
    <Image
      src={europeMap}
      alt=""
      width={1472}
      class="h-321 w-full object-cover"
    />
    <h1 class="kern-heading-large">
      Bezug zu EU-Interoperabilität
      <HelpButton sectionId="eu-interoperabilitaet" />
    </h1>
    <div class="space-y-16">
      <h2 id={bezug.labelId} class="kern-heading-medium">
        Ergab die Vorprüfung Bezug zu EU-Interoperabilität?
      </h2>
      <RadioField field={bezug} options={euInteroperabilitaetOptions} />
    </div>
  </div>

  <HelpSection
    slot="help"
    id="eu-interoperabilitaet"
    title="Bezug zu EU-Interoperabilität"
  >
    <p>
      Sofern durch Ihre Regelung vorgesehen ist, dass Daten und Informationen
      zwischen Verwaltungen von EU-Mitgliedstaaten ausgetauscht werden, muss
      nach{" "}
      <a href={linkToIEAArticle({ article: 3 })} target="_blank" rel="noopener">
        Art. 3 der Verordnung für ein interoperables Europa (EU) 2024/903
      </a>{" "}
      in der Regel eine Interoperabilitätsbewertung durchgeführt werden.
    </p>
    <p>
      <a href={interopsAssessment.path} target="_blank" rel="noopener">
        Wann ist eine Interoperabilitäts-Bewertung verpflichtend?
      </a>
    </p>
    <p>
      Sollte sich nach den Bestimmungen der Verordnung dennoch keine
      Verpflichtung zu einer Bewertung ergeben und Sie möchten auch keine
      freiwillige Bewertung durchführen, wählen Sie die Option „Nein, es ist
      kein Bezug vorhanden“.
    </p>
  </HelpSection>
</StepPage>
