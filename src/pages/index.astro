---
import bundeslaenderImage from "@/assets/images/startseite-bundeslaender.png";
import euInteroperabilitaetImage from "@/assets/images/europa-karte.png";
import { LinkButton } from "@/components/Button";
import FeatureItem from "@/components/FeatureItem.astro";
import FeatureSet from "@/components/FeatureSet.astro";
import Hero from "@/components/Hero.astro";
import KernCard from "@/components/KernCard.astro";
import {
  bundeslaender,
  dokumentation,
  interoperabel,
  interoperabel_nationaleKontaktstelle,
  methoden,
  prinzipien,
  assistent_vorpruefung,
} from "@/config/routes";
import Layout from "@/layouts/Layout.astro";
import {
  ZFL_BASE_URL,
  ZFL_PATH_RESSOURCEN,
  ZFL_PATH_SCHULUNGEN,
} from "@/resources/constants";
import { contact } from "@/resources/content/shared/contact";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import IconArrowDownward from "~icons/ic/baseline-arrow-downward";
import IconMail from "~icons/ic/baseline-mail";
import IconPhone from "~icons/ic/baseline-phone";
import IconAddLocationAlt from "~icons/ic/round-add-location-alt";
import IconComputer from "~icons/ic/round-computer";
import IconEditNote from "~icons/ic/round-edit-note";
import IconQueryBuilder from "~icons/ic/round-query-builder";

export const frontmatter = {
  title: "Startseite",
};

const WAS_IST_DIGITALTAUGLICHKEIT_ID = "was-ist-digitaltauglichkeit";

const steps = [
  {
    title: "Vorprüfung durchlaufen",
    subline:
      "Sie identifizieren den Digitalbezug und Interoperabilitätsanforderungen für Ihr Vorhaben.",
    facts: [
      { label: "Zeitpunkt", text: "Vor dem Schreiben der Regelung" },
      { label: "Dauer", text: "Wenige Minuten" },
      {
        label: "Ergebnis",
        text: "Individueller Digital- und Interoperabilitätsbezug",
      },
    ],
    link: { text: "Vorprüfung starten", href: assistent_vorpruefung.path },
  },
  {
    title: "Regelung erarbeiten",
    subline:
      "Bei positivem Digitalbezug wenden Sie die fünf Prinzipien auf Ihre Regelungsvorhaben an. Zudem finden Sie verschiedene Hilfestellungen, die Sie unterstützen.",
    facts: [
      {
        label: "Dauer",
        text: "Punktuell über die gesamte Regelungsausarbeitung",
      },
      {
        label: "Ergebnis",
        text: "Digitaltaugliche Regelung und Visualisierungen",
      },
    ],
    link: { text: "Zur Erarbeitung", href: methoden.path },
    externalLink: {
      text: "Ressourcen",
      href: ZFL_BASE_URL + ZFL_PATH_RESSOURCEN,
    },
  },
  {
    title: "Digitalcheck dokumentieren",
    subline:
      "Sie dokumentieren, wie Sie Digitaltauglichkeit in Ihrer Regelung sichergestellt haben.",
    facts: [
      { label: "Zeitpunkt", text: "Parallel zum Erarbeiten der Regelung" },
      { label: "Dauer", text: "Ein bis zwei Stunden" },
      {
        label: "Ergebnis",
        text: "Abgeschlossene Dokumentation der Digitaltauglichkeit",
      },
    ],
    link: { text: "Dokumentation erstellen", href: dokumentation.path },
  },
];

// Highlight colors per principle, in display order.
const principleColors = [
  { number: "bg-kern-orange-025", text: "bg-kern-orange-025" },
  { number: "bg-kern-red-100", text: "bg-kern-red-050" },
  { number: "bg-kern-violet-050", text: "bg-kern-violet-050" },
  { number: "bg-kern-green-025", text: "bg-kern-green-025" },
  { number: "bg-kern-lightblue-025", text: "bg-kern-lightblue-025" },
];

const principles = (await getCollection("prinzipien"))
  .map((entry) => entry.data)
  .sort((a, b) => a.order - b.order);
---

<Layout>
  <main class="breakout-grid">
    <Hero variant="dark">
      <h1 class="mb-24">Digitaltaugliche Regelungen erarbeiten</h1>
      <p class="kern-body py-0">
        Der Digitalcheck sorgt dafür, dass Regelungen digitaltauglich umsetzbar
        sind – für praxistaugliche Abläufe und weniger Bürokratie in Bund und
        Ländern.
      </p>
      <div class="flex flex-wrap gap-24 pt-24 pb-16">
        <LinkButton
          href={assistent_vorpruefung.path}
          iconLeft="kern-icon--arrow-forward"
        >
          Digitalcheck starten
        </LinkButton>
        <a
          href={`#${WAS_IST_DIGITALTAUGLICHKEIT_ID}`}
          class="kern-btn kern-btn--secondary link-unstyled"
        >
          <IconArrowDownward class="size-24" aria-hidden="true" />
          <span class="kern-label">Was ist Digitaltauglichkeit?</span>
        </a>
      </div>
    </Hero>

    <section class="breakout py-64">
      <div class="space-y-32">
        <h2>Der Digitalcheck in drei Schritten</h2>
        <p class="kern-body">
          Wenden Sie den Digitalcheck auf Ihr Regelungsvorhaben an.
        </p>
        <ol class="list-unstyled grid gap-32 lg:grid-cols-3">
          {steps.map((step, index) => (
            <li class="[&_.kern-btn]:flex-none">
              <KernCard title={step.title} headingLevel={3} body={step.subline}>
                <span
                  slot="pre-header"
                  class="kern-number border-kern-action-default text-kern-action-default mb-16"
                  aria-hidden="true"
                >
                  {index + 1}
                </span>
                {step.facts.map((fact) => (
                  <p class="kern-body kern-body--muted">
                    <b>{fact.label}</b>: {fact.text}
                  </p>
                ))}
                <Fragment slot="footer">
                  <LinkButton href={step.link.href} look="secondary">
                    {step.link.text}
                  </LinkButton>
                  {step.externalLink && (
                    <LinkButton
                      href={step.externalLink.href}
                      look="ghost"
                      className="px-0"
                      iconLeft="kern-icon--open-in-new"
                      target="_blank"
                      rel="noreferrer"
                    >
                      {step.externalLink.text}
                    </LinkButton>
                  )}
                </Fragment>
              </KernCard>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section
      id={WAS_IST_DIGITALTAUGLICHKEIT_ID}
      class="breakout bg-kern-darkblue-050 py-64"
    >
      <div class="space-y-32">
        <h2>Was ist Digitaltauglichkeit?</h2>
        <FeatureSet>
          <FeatureItem
            title="Reibungslose digitale Umsetzung"
            body="Regelungen werden vermehrt digital umgesetzt. Digitaltaugliche Regelungen stellen sicher, dass der digitalen Umsetzung nicht im Wege steht."
          >
            <IconComputer slot="icon" class="size-74" />
          </FeatureItem>
          <FeatureItem
            title="Ressourcen sparen"
            body="Eine gute digitale Umsetzung spart langfristig Zeit und sorgt dafür, dass Ziel und Wirkung des Vorhabens erreicht werden – für Bürgerinnen, Bürger und Verwaltung."
          >
            <IconQueryBuilder slot="icon" class="size-74" />
          </FeatureItem>
        </FeatureSet>
        <FeatureSet>
          <FeatureItem
            title="Gilt für alle Bundesregelungen ..."
            body="Der Digitalcheck gilt für alle Regelungsvorhaben auf Bundesebene – Gesetze, Verordnungen und Verwaltungsvorschriften, neu und bestehend."
          >
            <IconEditNote slot="icon" class="size-74" />
          </FeatureItem>
          <FeatureItem
            title="... und für die Länder"
            body="Immer mehr Länder prüfen ihre Regelungen verbindlich auf Digitaltauglichkeit. Mit unseren Kooperationspartnern verfolgen wir dasselbe Ziel: Regelungen, die von Anfang an digital umsetzbar sind."
          >
            <IconAddLocationAlt slot="icon" class="size-74" />
          </FeatureItem>
        </FeatureSet>
      </div>
    </section>

    <section class="breakout py-64">
      <div class="flex flex-col gap-32 lg:flex-row lg:justify-between lg:gap-16">
        <div class="space-y-16 lg:max-w-488">
          <h2>Fünf Prinzipien der Digitaltauglichkeit</h2>
          <p class="kern-body">
            Fünf Prinzipien helfen Ihnen dabei, Chancen der digitaltauglichen
            Umsetzung auszuschöpfen und Hindernisse frühzeitig zu erkennen.
          </p>
          <div class="pt-16">
            <LinkButton href={prinzipien.path}>Zu den Prinzipien</LinkButton>
          </div>
        </div>
        <ol class="list-unstyled flex flex-col gap-8 lg:w-712">
          {principles.map((principle, index) => (
            <li class="flex items-baseline gap-12 py-4">
              <span
                class:list={[
                  "kern-number border-0",
                  principleColors[index].number,
                ]}
              >
                {index + 1}
              </span>
              <p class="kern-subline kern-subline--large text-kern-layout-text-default">
                <span
                  class:list={[
                    "box-decoration-clone px-4 py-4",
                    principleColors[index].text,
                  ]}
                >
                  {principle.Name}
                </span>
              </p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="breakout bg-kern-layout-layer-surface py-64">
      <div class="grid gap-32 lg:grid-cols-2">
        <KernCard
          title="EU-Interoperabilität"
          body="Neben der Digitaltauglichkeit prüft der Digitalcheck auch die Interoperabilitätsanforderungen gemäß EU-Verordnung 2024/903 (Interoperables Europa)."
        >
          <Image
            slot="image"
            src={euInteroperabilitaetImage}
            alt="Eine stilisierte Karte von Europa. Die EU-Mitgliedstaaten sind heller markiert und durch überlappende, gestrichelte Linien miteinander vernetzt."
            widths={[600, 1200]}
            sizes="(min-width: 64rem) 592px, 100vw"
            class="aspect-video w-full object-cover"
          />
          <Fragment slot="footer">
            <LinkButton href={interoperabel.path}>
              Zu EU-Interoperabilität
            </LinkButton>
            <LinkButton
              href={interoperabel_nationaleKontaktstelle.path}
              look="secondary"
            >
              Nationale Kontaktstelle
            </LinkButton>
          </Fragment>
        </KernCard>

        <div class="[&_.kern-btn]:flex-none">
          <KernCard
            title="Digitalcheck für Bundesländer"
            body="Durch eine Kooperation mit dem Bund können Sie den Digitalcheck für Ihr Bundesland direkt auf der Webseite des Digitalcheck Bund integrieren."
          >
            <Image
              slot="image"
              src={bundeslaenderImage}
              alt="Eine stilisierte Karte von Deutschland mit den Grenzen der 16 Bundesländer."
              widths={[600, 1200]}
              sizes="(min-width: 64rem) 592px, 100vw"
              class="aspect-video w-full object-cover"
            />
            <LinkButton
              slot="footer"
              href={bundeslaender.path}
              look="secondary"
            >
              Zur Übersicht
            </LinkButton>
          </KernCard>
        </div>
      </div>
    </section>

    <section class="breakout py-64">
      <div class="space-y-24">
        <h2>Unterstützungsangebote</h2>
        <p class="kern-body">
          Alle Angebote wie Schulungen, Werkzeuge und Beispiele finden Sie beim
          Zentrum für Legistik.
        </p>
        <ul class="list-unstyled space-y-8">
          <li>
            <a class="kern-link items-center" href={contact.phone}>
              <IconPhone class="size-24" aria-hidden="true" />
              {contact.phoneDisplay}
            </a>
          </li>
          <li>
            <a class="kern-link items-center" href={`mailto:${contact.email}`}>
              <IconMail class="size-24" aria-hidden="true" />
              {contact.email}
            </a>
          </li>
        </ul>
        <div class="flex flex-wrap gap-24 pt-12">
          <LinkButton
            href={ZFL_BASE_URL}
            iconLeft="kern-icon--open-in-new"
            target="_blank"
            rel="noreferrer"
          >
            Zum Zentrum für Legistik
          </LinkButton>
          <LinkButton
            href={ZFL_BASE_URL + ZFL_PATH_SCHULUNGEN}
            look="secondary"
            iconLeft="kern-icon--open-in-new"
            target="_blank"
            rel="noreferrer"
          >
            Schulungen
          </LinkButton>
        </div>
      </div>
    </section>
  </main>
</Layout>
