---
import DocumentationWizard from "@/components/DocumentationWizard.astro";
import HelpSection from "@/components/HelpSection.astro";

export const frontmatter = {
  title: "Regelungsvorhaben",
  sitemap: false,
};
---

<DocumentationWizard stepTitle={frontmatter.title}>
  <HelpSection id="title" title="Hinweis zu Titel des Regelungsvorhabens">
    Geben Sie hier den offiziellen Titel Ihres Regelungsvorhabens ein. Dieser
    Titel wird in der fertigen Dokumentation verwendet.
  </HelpSection>
</DocumentationWizard>
