---
import DocumentationWizard from "@/components/DocumentationWizard.astro";
import HelpSection from "@/components/HelpSection.astro";
import RichText from "@/components/RichText";
import { prinzipien } from "@/config/routes";
import { getPrinzipienStaticPaths } from "@/content.config";

export const getStaticPaths = getPrinzipienStaticPaths;

// props are generated by getStaticPaths
const { prinzip } = Astro.props;
const { principleId } = Astro.params;
---

<DocumentationWizard stepTitle={prinzip.Name} principleId={principleId}>
  <HelpSection id="1-prinzip" title={`Hinweis zu „${prinzip.Name}“`}>
    <RichText markdown={prinzip.Hilfetext} />
    <a href={`${prinzipien.path}/${prinzip.URLBezeichnung}`} class="kern-link">
      <span
        class="kern-icon kern-icon--arrow-forward"
        aria-hidden="true"
      ></span>
      Mehr zum Prinzip
    </a>
  </HelpSection>
  <HelpSection id="schwerpunkte" title="Schwerpunkte dieses Prinzips">
    <p>Wählen Sie aus, welche Schwerpunkte für Ihr Vorhaben relevant sind.</p>
    <p>
      Diese dienen Ihnen als roter Faden für Ihre Erklärung. So formulieren Sie
      präzise und stellen sicher, dass Ihre Regelung das Prinzip erfüllt.
    </p>
    <div>
      {prinzip.Aspekte.map((aspekt) => (
        <details class="kern-accordion">
          <summary class="kern-accordion__header">
            <span class="kern-title">{aspekt.Kurzbezeichnung}</span>
          </summary>
          <div class="kern-accordion__body">
            <RichText className="kern-body" markdown={aspekt.Text} />
          </div>
        </details>
      ))}
    </div>
  </HelpSection>
</DocumentationWizard>
