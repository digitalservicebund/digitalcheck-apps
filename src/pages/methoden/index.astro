---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/Hero.astro";
import ButtonContainer from "@/components/ButtonContainer";
import { LinkButton } from "@/components/Button";
import InfoBox from "@/components/InfoBox";
import InfoBoxSideBySide from "@/components/InfoBoxSideBySide.astro";
import NumberedList from "@/components/NumberedList";
import RichText from "@/components/RichText";
import SupportBanner from "@/components/SupportBanner";
import TimelineList from "@/components/TimelineList.astro";
import { methods } from "@/resources/content/methoden";
import { supportBanner } from "@/resources/content/shared/support-banner";
import type { ContentLink } from "@/utils/contentTypes";

export const frontmatter = {
  title: "Regelung erarbeiten",
};
---

<Layout title={frontmatter.title}>
  <main class="breakout-grid">
    <Hero>
      <h1>{methods.title}</h1>
      <RichText markdown={methods.subtitle} />
    </Hero>

    <section>
      <TimelineList>
        {methods.steps.items.map((step, index) => {
          const headingId = `step-h-${index}`;

          if (step.isSubstep)
            return (
              <li aria-labelledby={headingId}>
                <div class="flex flex-col gap-16 bg-blue-100 px-16 py-32 sm:px-32 sm:pt-40 sm:pb-48">
                  <h3 id={headingId}>{step.headline.text}</h3>
                  <RichText markdown={step.text} />
                  {step.links && (
                    <ButtonContainer>
                      {step.links.map(
                        ({ to, text, externalLink, ...rest }: ContentLink) => (
                          <LinkButton
                            href={to}
                            iconRight={
                              externalLink
                                ? "kern-icon--open-in-new"
                                : undefined
                            }
                            {...rest}
                          >
                            {text}
                          </LinkButton>
                        ),
                      )}
                    </ButtonContainer>
                  )}
                </div>
              </li>
            );
          return (
            <li
              class="timeline-plain-item flex flex-col gap-16 pt-4"
              aria-labelledby={headingId}
            >
              <h2 id={headingId}>{step.headline.text}</h2>
              <RichText markdown={step.text} />
            </li>
          );
        })}
      </TimelineList>
    </section>

    <section class="space-y-40">
      <InfoBox
        heading={{ tagName: "h2", text: methods.furtherMethods.heading }}
      >
        <RichText markdown={methods.furtherMethods.content} />
      </InfoBox>

      <InfoBoxSideBySide>
        <InfoBox
          look="method"
          badge={{ children: methods.itSystems.badge, look: "hint" }}
          heading={{
            text: methods.itSystems.heading,
            tagName: "h3",
          }}
        >
          <RichText markdown={methods.itSystems.content} />
          <InfoBox.LinkList links={methods.itSystems.links} />
        </InfoBox>
        <InfoBox
          look="method"
          badge={{
            children: methods.technicalFeasibility.badge,
            look: "hint",
          }}
          heading={{
            text: methods.technicalFeasibility.heading,
            tagName: "h3",
          }}
        >
          <RichText markdown={methods.technicalFeasibility.content} />
          <InfoBox.LinkList links={methods.technicalFeasibility.links} />
        </InfoBox>
        <InfoBox
          look="method"
          badge={{
            children: methods.interviewMethods.badge,
            look: "hint",
          }}
          heading={{
            text: methods.interviewMethods.heading,
            tagName: "h3",
          }}
        >
          <RichText markdown={methods.interviewMethods.content} />
          <InfoBox.LinkList links={methods.interviewMethods.links} />
        </InfoBox>
      </InfoBoxSideBySide>
    </section>

    <SupportBanner {...supportBanner} />

    <section class="space-y-32">
      <h2>{methods.nextSteps.title}</h2>
      <NumberedList>
        {methods.nextSteps.items.map((item) => (
          <NumberedList.Item className="space-y-16" disabled={item.isDisabled}>
            <p class="kern-body kern-body--large">{item.headline.text}</p>
            {"content" in item && (
              <RichText markdown={item.content as string} />
            )}
            {item.link && "to" in item.link && (
              <a href={item.link.to}>{item.link.text}</a>
            )}
          </NumberedList.Item>
        ))}
      </NumberedList>
    </section>
  </main>
</Layout>
