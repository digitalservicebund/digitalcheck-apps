---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/Hero.astro";
import Metadata from "./_Metadata.astro";
import Timeline from "@/components/Timeline";
import RichText from "@/components/RichText.tsx";
import { news } from "@/resources/content/das-ist-neu";
import { contact } from "@/resources/content/shared/contact";
import { mailto } from "@/utils/mailtoHelper";

export const frontmatter = {
  title: "Das ist neu",
};

const TimelineItem = Timeline.Item;

const PAGE_SIZE = 9;

// Year markers get the index of the following entry, so they appear together with it
let entryCount = 0;
const items = news.items.map((item) => ({
  ...item,
  index: item.year ? entryCount : entryCount++,
}));
---

<Layout title={frontmatter.title}>
  <main class="breakout-grid">
    <Hero>
      <h1>Das ist neu</h1>
      <p>
        Das Digitalcheck-Angebot wird kontinuierlich{" "}
        <a href="https://zfl.bund.de/ueber/daran-arbeiten-wir">
          weiterentwickelt
        </a>
        . Hier finden Sie eine Übersicht der neuesten Ergänzungen und
        Änderungen.
      </p>
      <p>
        Haben Sie Anregungen oder Wünsche? Schreiben Sie uns gerne eine E-Mail
        an{" "}
        <a href={mailto(contact.email, "Supportanfrage: digitalcheck.bund.de")}>
          {contact.email}
        </a>{" "}
        oder rufen Sie uns an unter{" "}
        <a href={contact.phone}>{contact.phoneDisplay}</a>.
      </p>
      <Metadata lastUpdate="31.08.2026" />
    </Hero>
    <section
      class="py-80"
      x-data={`{
        visible: ${PAGE_SIZE},
        showMore() {
          const firstNew = this.visible;
          this.visible += ${PAGE_SIZE};
          this.$nextTick(() =>
            this.$root.querySelector('[data-entry-index="' + firstNew + '"]')?.focus(),
          );
        },
      }`}
    >
      {/* Indent so year badges, centered on the line, don't overhang the content column */}
      <Timeline className="pl-28">
        {items.map((item) =>
          item.year ? (
            <TimelineItem year={item.year} x-show={`visible > ${item.index}`} />
          ) : (
            <TimelineItem
              bullet
              x-show={`visible > ${item.index}`}
              data-entry-index={item.index}
              tabIndex={-1}
              className="pb-40 pl-8"
            >
              {"badge" in item && (
                <div class="flex">
                  <span class="kern-badge kern-badge--small border-0 bg-[#F3F4F7]">
                    <span class="kern-label font-normal">
                      {item.badge!.text}
                    </span>
                  </span>
                </div>
              )}
              {item.headline && (
                <h2 class="kern-heading-medium pt-24 pb-16">
                  {item.headline.text}
                </h2>
              )}
              {item.content && <RichText markdown={item.content} />}
            </TimelineItem>
          ),
        )}
      </Timeline>
      {entryCount > PAGE_SIZE && (
        <button
          type="button"
          class="kern-btn kern-btn--tertiary"
          style="display: none"
          x-show={`visible < ${entryCount}`}
          x-on:click="showMore()"
        >
          <span
            class="kern-icon kern-icon--arrow-down kern-icon--default"
            aria-hidden="true"
          ></span>
          <span class="kern-label">Mehr anzeigen</span>
        </button>
      )}
    </section>
  </main>
</Layout>
