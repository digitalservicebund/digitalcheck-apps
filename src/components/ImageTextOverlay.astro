---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import InfoPanel, {
  type Props as InfoPanelProps,
} from "@/components/InfoPanel.astro";

interface Props {
  image: ImageMetadata;
  imageAlt: string;
  imageBorder?: boolean;
  imageClass?: string;
  linkHref?: string;
  linkText?: string;
  icon?: string;
  look?: InfoPanelProps["look"];
  padding?: InfoPanelProps["padding"];
}

const {
  image,
  imageAlt,
  imageBorder,
  imageClass,
  linkHref,
  linkText,
  icon = "arrow-forward",
  look = "gray",
  padding = "medium",
} = Astro.props;
---

<div class="relative max-lg:space-y-24 lg:grid lg:h-482 lg:grid-cols-6 lg:items-center lg:overflow-hidden">
  <InfoPanel
    look={look}
    padding={padding}
    class="z-1 self-start lg:col-span-3 lg:w-624 lg:self-center"
  >
    <slot />
    {linkHref && linkText && (
      <a class="kern-link self-start" href={linkHref}>
        <span
          class={`kern-icon kern-icon--${icon} kern-icon--default`}
          aria-hidden="true"
        />
        {linkText}
      </a>
    )}
  </InfoPanel>
  <Image
    src={image}
    alt={imageAlt}
    class:list={[
      "object-cover lg:absolute lg:right-1 lg:h-482 lg:w-727",
      imageBorder && "border border-lavender-base",
      imageClass,
    ]}
  />
</div>
