---
import IconClose from "~icons/ic/outline-close";

/**
 * Help panel of the documentation wizard, filled with the page's `HelpSection`s.
 * A `HelpButton` opens it by setting `data-open`.
 */
---

<div
  id="help-panel"
  x-data="helpSidepanel()"
  x-init="setup($refs.scrollable)"
  @scroll.window="adjustHeight()"
  @resize.window="adjustHeight()"
  class="help peer relative hidden border-l border-kern-darkblue-100 bg-white data-open:block max-xl:fixed max-xl:inset-y-0 max-xl:right-0 max-xl:z-50 max-xl:w-[80vw] max-xl:max-w-[400px] max-xl:shadow-2xl"
>
  <div class="sticky top-0">
    <div class="absolute right-16 left-0 z-10 flex flex-row justify-end bg-white px-16 pt-24 pb-16">
      <button
        type="button"
        aria-label="Hilfe-Panel schließen"
        class="kern-btn kern-btn--secondary w-auto fill-kern-action-default p-6"
        @click="$root.removeAttribute('data-open')"
      >
        <IconClose class="h-20 w-20" />
      </button>
    </div>
    <div class="before:pointer-events-none before:absolute before:top-48 before:right-16 before:left-0 before:h-40 before:bg-[linear-gradient(to_bottom,white,transparent)] before:blur-xs before:content-[''] after:pointer-events-none after:absolute after:right-16 after:bottom-0 after:left-0 after:h-40 after:bg-[linear-gradient(to_top,white,transparent)] after:blur-xs after:content-['']">
      <div
        x-ref="scrollable"
        class="max-h-screen [scrollbar-gutter:stable] overflow-x-hidden overflow-y-hidden pt-80 pb-40 wrap-break-word hover:overflow-y-auto max-lg:[scrollbar-gutter:auto] max-lg:overflow-y-auto"
      >
        <div class="w-full space-y-32 pr-16 pl-32">
          <slot />
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Mobile backdrop -->
<div
  x-data
  @click="document.getElementById('help-panel').removeAttribute('data-open')"
  class="fixed inset-0 z-40 hidden bg-black/20 backdrop-blur-sm max-xl:peer-data-open:block"
  aria-hidden="true"
></div>

<style is:global>
  @media (width < 80rem) {
    body:has(#help-panel[data-open]) {
      overflow: hidden;
    }
  }
</style>

<script>
  import Alpine from "alpinejs";
  import { helpSidepanelData } from "@/utils/helpSidepanel";

  document.addEventListener("alpine:init", () => {
    Alpine.data("helpSidepanel", helpSidepanelData);
  });
</script>
