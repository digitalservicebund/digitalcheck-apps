---
import AccordeonMenu from "@/components/global/AccordionMenu.astro";
import {
  getRouteByPath,
  getRouteChain,
  hasVisibleChildren,
} from "@/utils/navigation/routeUtils";

const currentRoute = getRouteByPath(Astro.url.pathname);
const [sectionRoot] = currentRoute ? getRouteChain(currentRoute) : [];
const showSidebar = !!sectionRoot && hasVisibleChildren(sectionRoot);
---

{showSidebar && sectionRoot && currentRoute && (
  <nav
    aria-label="Abschnittsnavigation"
    class="bg-kern-layout-layer-surface hidden border-r border-neutral-300 *:sticky *:top-0 *:max-h-dvh min-[900px]:block"
  >
    <AccordeonMenu sectionRoot={sectionRoot} currentPath={currentRoute.path} />
  </nav>
)}
