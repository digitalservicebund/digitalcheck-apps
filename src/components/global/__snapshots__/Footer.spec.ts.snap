exports[`Footer Component > Renders correctly 1`] = `"<footer id="footer" class="breakout-grid print:hidden" aria-label="Seitenfußbereich"><!-- Re-map KERN's contextual colors so text and links render light-on-dark. --><div class="bg-kern-darkblue-800 breakout border-t-2 border-blue-300 [--kern-color-action-default-contextual:var(--kern-color-white)] [--kern-color-action-focus-default-contextual:var(--kern-color-white)] [--kern-color-action-visited:var(--kern-color-white)] [--kern-color-layout-text-default-contextual:var(--kern-color-layout-text-inverse)]"><div class="flex flex-col gap-40 pt-64 pb-40"><nav class="grid grid-cols-1 gap-32 sm:grid-cols-3" aria-label="Schnellübersicht"><div class="kern-stack kern-stack-lg"><h2 class="kern-heading-medium mb-0 py-0">Digitalcheck</h2><ul class="list-unstyled flex flex-col gap-2"><li><a href="/" class="kern-link kern-link--small">Übersicht</a></li><li><a href="/assistent/vorpruefung" class="kern-link kern-link--small">Vorprüfung</a></li><li><a href="/methoden" class="kern-link kern-link--small">Erarbeitung</a></li><li><a href="/dokumentation" class="kern-link kern-link--small">Dokumentation</a></li></ul></div><div class="kern-stack kern-stack-lg"><h2 class="kern-heading-medium mb-0 py-0">Inhalte</h2><ul class="list-unstyled flex flex-col gap-2"><li><a href="/prinzipien" class="kern-link kern-link--small">Fünf Prinzipien</a></li><li><a href="/interoperabel" class="kern-link kern-link--small">EU-Interoperabilität</a></li><li><a href="/bundeslaender" class="kern-link kern-link--small">Bundesländer</a></li><li><a href="/normenkontrollrat" class="kern-link kern-link--small">Normenkontrollrat</a></li><li><a href="/das-ist-neu" class="kern-link kern-link--small">Das ist neu</a></li></ul></div><div class="kern-stack kern-stack-lg"><h2 class="kern-heading-medium mb-0 py-0">Rechtliche Hinweise</h2><ul class="list-unstyled flex flex-col gap-2"><li><a href="/impressum" class="kern-link kern-link--small">Impressum</a></li><li><a href="/datenschutz" class="kern-link kern-link--small">Datenschutzerklärung</a></li><li><a href="/barrierefreiheit" class="kern-link kern-link--small">Barrierefreiheit</a></li><li><a href="/sitemap" class="kern-link kern-link--small">Sitemap</a></li></ul></div></nav><div class="flex flex-col gap-40"><div class="kern-stack kern-stack-lg"><h2 class="kern-heading-medium mb-0 py-0">Kontaktieren Sie uns</h2><ul class="list-unstyled flex flex-col gap-2"><li><a href="tel:+4915140767839" class="kern-link kern-link--small">0151 / 4076 7839</a></li><li><a href="mailto:digitalcheck@digitalservice.bund.de" class="kern-link kern-link--small">digitalcheck@digitalservice.bund.de</a></li></ul></div><div class="flex flex-wrap items-baseline justify-between gap-x-24 gap-y-8"><p class="kern-body kern-body--small mb-0 flex items-baseline gap-x-8 py-0">Ein Angebot der<a href="https://digitalservice.bund.de/" target="_blank" rel="noreferrer" class="kern-link kern-link--small">DigitalService GmbH des Bundes</a></p><div class="flex flex-wrap gap-x-24"><a href="https://zfl.bund.de" target="_blank" rel="noreferrer" class="kern-link kern-link--small">Zentrum für Legistik</a><a href="https://zfl.bund.de/ueber/zahlen-und-fakten" target="_blank" rel="noreferrer" class="kern-link kern-link--small">Zahlen und Fakten</a><a href="https://github.com/digitalservicebund/digitalcheck-dito" target="_blank" rel="noreferrer" class="kern-link kern-link--small">Open Source Code</a></div></div></div></div></div><nav aria-label="Externe Verlinkungen" class="breakout bg-white"><div class="flex flex-col gap-16 py-40 sm:flex-row sm:gap-48"><img src="/logo/bmds-logo.svg" width="137" alt="Logo des Bundesministerium für Digitales und Staatsmodernisierung" class="shrink-0 self-start forced-colors:dark:hidden"><img src="/logo/bmds-logo-white.svg" width="137" alt="Logo des Bundesministerium für Digitales und Staatsmodernisierung" class="hidden shrink-0 self-start forced-colors:dark:block"><div class="max-w-3xl space-y-8 [&amp;_p]:max-w-none"><h3 class="kern-label kern-label--small">Federführung</h3><p class="kern-body kern-body--small">Der Digitalcheck entsteht im Auftrag des <a href="https://bmds.bund.de/" target="_blank" rel="noreferrer" class="kern-link kern-link--small">Bundesministerium für Digitales und Staatsmodernisierung</a></p><p class="kern-body kern-body--small">Mehr über den politischen Auftrag und die Entstehung des Digitalcheck finden Sie auf der <a href="https://www.digitale-verwaltung.de/Webs/DV/DE/transformation/digitalcheck/digitalcheck-node.html" target="_blank" rel="noreferrer" class="kern-link kern-link--small">Projektseite</a> des Bundesministeriums für Digitales und Staatsmodernisierung.</p></div></div></nav></footer>"`;
