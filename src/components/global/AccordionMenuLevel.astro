---
import Self from "@/components/global/AccordionMenuLevel.astro";
import { twMerge } from "tailwind-merge";
import type { AccordeonNavigationEntry } from "@/utils/navigation/accordion";
import {
  getWizardIdForPath,
  getWizardSession,
  wizardFlows,
} from "@/wizard/session";

interface Props {
  entries: AccordeonNavigationEntry[];
  currentPath: string;
  level?: number;
}

const { entries, currentPath, level = 0 } = Astro.props;

function isCollapsible(entry: AccordeonNavigationEntry, currentLevel: number) {
  return currentLevel >= 1 && entry.children.length > 0;
}

function arrowHoverStyle(isCurrent = false) {
  return isCurrent
    ? "hover:bg-(--kern-color-white)"
    : "hover:bg-kern-darkblue-900 hover:[&>.kern-icon]:bg-(--kern-color-white) peer-hover:[&>.kern-icon]:bg-(--kern-color-white)";
}

function linkHoverStyle(isCurrent = false) {
  return isCurrent
    ? "bg-kern-darkblue-050 font-bold"
    : "hover:bg-kern-darkblue-800 hover:text-white";
}

function headerStyle(isCurrent = false) {
  return isCurrent
    ? "bg-kern-darkblue-050 font-bold"
    : "has-[>button:hover]:bg-kern-darkblue-800 has-[>button:hover]:[&>a]:text-white has-[>a:hover]:bg-kern-darkblue-800 has-[>a:hover]:text-white";
}

function indentStyle(currentLevel: number) {
  // each level below 2 is indented further
  const paddingLeft =
    currentLevel > 1
      ? `calc(var(--kern-metric-space-x-large) + ${currentLevel - 2} * var(--kern-metric-space-default))`
      : "var(--kern-metric-space-small)";
  return `padding: var(--kern-metric-space-small) var(--kern-metric-space-small) var(--kern-metric-space-small) ${paddingLeft}`;
}

// Wizard pages that can't be reached without user data, e.g. the result page,
// are disabled at build time. The script below enables them with the stored data.
function isLockedWizardPage(path: string) {
  const wizardId = getWizardIdForPath(path);
  if (!wizardId) return false;
  const { initialPath } = wizardFlows[wizardId];
  return !getWizardSession(wizardId, initialPath).isReachable(path);
}

function panelId(path: string) {
  return `accordion-panel-${path.replace(/[^a-zA-Z0-9]+/g, "-").replace(/^-+|-+$/g, "")}`;
}
---

{entries.map((entry) =>
  isCollapsible(entry, level) ? (
    <div class="accordion-item" x-data={`{ open: ${entry.isInCurrentBranch} }`}>
      <div
        class={twMerge(
          headerStyle(entry.isCurrent),
          "kern-accordion__header rounded-sm",
        )}
      >
        <a
          href={entry.path}
          style={indentStyle(level)}
          class={twMerge(
            linkHoverStyle(entry.isCurrent),
            "peer link-unstyled kern-body block flex-1 rounded-sm",
          )}
          aria-current={entry.isCurrent ? "page" : undefined}
        >
          {entry.label}
        </a>
        <button
          type="button"
          class={twMerge(
            arrowHoverStyle(entry.isCurrent),
            "mr-3 flex h-32 w-32 shrink-0 items-center justify-center rounded-sm cursor-pointer",
          )}
          aria-label={`Untermenü ${entry.label} ein-/ausklappen`}
          aria-controls={panelId(entry.path)}
          x-bind:aria-expanded="open"
          @click="open = !open"
        >
          <span
            class="kern-icon kern-icon--arrow-down kern-icon--default"
            style={entry.isInCurrentBranch ? undefined : "display: none;"}
            x-show="open"
            aria-hidden="true"
          />
          <span
            class="kern-icon kern-icon--chevron-right kern-icon--default"
            style={entry.isInCurrentBranch ? "display: none;" : undefined}
            x-show="!open"
            aria-hidden="true"
          />
        </button>
      </div>
      <section
        id={panelId(entry.path)}
        class="kern-accordion__body"
        style={entry.isInCurrentBranch ? undefined : "display: none;"}
        x-show="open"
      >
        <Self
          entries={entry.children}
          currentPath={currentPath}
          level={level + 1}
        />
      </section>
    </div>
  ) : (
    <>
      <a
        href={isLockedWizardPage(entry.path) ? undefined : entry.path}
        data-wizard-link={getWizardIdForPath(entry.path)}
        data-path={entry.path}
        aria-disabled={isLockedWizardPage(entry.path) ? "true" : undefined}
        class={twMerge(
          linkHoverStyle(currentPath === entry.path),
          "accordion-item link-unstyled kern-body relative block rounded-sm",
          "aria-disabled:text-kern-layout-text-muted aria-disabled:cursor-not-allowed aria-disabled:hover:bg-transparent aria-disabled:hover:text-kern-layout-text-muted",
        )}
        style={indentStyle(level)}
        aria-current={currentPath === entry.path ? "page" : undefined}
      >
        {/* Placed in the left padding, so the label doesn't shift when the
            script reveals the icon after loading the stored answers */}
        {getWizardIdForPath(entry.path) && (
          <span
            data-wizard-answered
            data-testid="CheckIcon"
            class="absolute top-kern-sm left-kern-xxs flex"
            hidden
          >
            <span
              class="kern-icon kern-icon--check kern-icon--default bg-kern-feedback-success"
              aria-hidden="true"
            />
            <span class="sr-only">Beantwortet:</span>
          </span>
        )}
        {entry.label}
      </a>
      {entry.children.length > 0 && (
        <Self
          entries={entry.children}
          currentPath={currentPath}
          level={level + 1}
        />
      )}
    </>
  ),
)}

<script>
  import type { WizardId } from "@/wizard/session";
  import { wizardStores } from "@/wizard/stores";

  document
    .querySelectorAll<HTMLAnchorElement>("a[data-wizard-link]")
    .forEach((link) => {
      const wizardId = link.dataset.wizardLink as WizardId;
      const path = link.dataset.path ?? "";

      // Also update when the answers change later, e.g. in another tab
      wizardStores[wizardId].$isAnswered.subscribe((isAnswered) => {
        const answeredMark = link.querySelector<HTMLElement>(
          "[data-wizard-answered]",
        );
        if (answeredMark) answeredMark.hidden = !isAnswered(path);
      });

      wizardStores[wizardId].$isReachable.subscribe((isReachable) => {
        if (isReachable(path)) {
          link.href = path;
          link.removeAttribute("aria-disabled");
        } else {
          link.removeAttribute("href");
          link.setAttribute("aria-disabled", "true");
        }
      });
    });
</script>

<style>
  .kern-accordion__header,
  .kern-accordion__body {
    padding: 0;
  }

  .kern-accordion__header::after {
    display: none;
  }

  .accordion-item {
    margin-top: 8px;
  }
</style>
