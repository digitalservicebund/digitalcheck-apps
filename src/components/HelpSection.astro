---
interface Props {
  /** Referenced by the `sectionId` of a `HelpButton` */
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<div id={`help-section-${id}`} class="scroll-my-120">
  <h3 class="kern-label kern-label--large mb-8">{title}</h3>
  <div class="space-y-8">
    <slot />
  </div>
</div>
