---
import { DocumentationRouter } from "@/routes/dokumentation.$page.tsx";
import LoadingPage from "@/components/LoadingPage.astro";
import { ClientRouter } from "astro:transitions";
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";
interface Props {
  stepTitle: string;
  principleId?: string;
  isErlaeuterung?: boolean;
}

const { principleId, stepTitle, isErlaeuterung } = Astro.props;
const prinzips = (await getCollection("prinzipien"))
  .map((entry) => entry.data)
  .sort((a, b) => a.order - b.order);
---

<Layout title={`Dokumentation: ${stepTitle}`} noMenu>
  <ClientRouter />
  <DocumentationRouter
    client:only="react"
    transition:persist={"documentation"}
    prinzips={prinzips}
    path={Astro.url.pathname}
    principleId={principleId}
    isErlaeuterung={isErlaeuterung}
  >
    <LoadingPage slot="fallback">Lade Dokumentation…</LoadingPage>
  </DocumentationRouter>
</Layout>
