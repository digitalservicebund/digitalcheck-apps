---
import type { StepField } from "@/wizard/stepFields";
import FieldError from "./FieldError.astro";

interface Props {
  field: StepField<string>;
  type?: "text" | "email" | "url" | "tel";
}

const { field, type = "text" } = Astro.props;
const hasDescription = Astro.slots.has("description");
---

<!--
  Slots:
  - default: label
  - description: hint below the label
  Wired up by bindStepForm via `name`.
-->
<div class="kern-form-input" data-wizard-field={field.name}>
  <label for={field.name} class="kern-label">
    <slot />
  </label>
  {hasDescription && (
    <p class="kern-hint" id={field.descriptionId}>
      <slot name="description" />
    </p>
  )}
  <input
    type={type}
    id={field.name}
    name={field.name}
    aria-describedby={hasDescription ? field.descriptionId : undefined}
    aria-errormessage={field.errorId}
    class="kern-form-input__input aria-invalid:border-yellow-700 aria-invalid:text-black aria-invalid:focus:border-4 aria-invalid:focus:border-yellow-700 aria-invalid:focus:outline-none"
  />
  <FieldError id={field.errorId} />
</div>
