---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { tv, type VariantProps } from "tailwind-variants";

const cardStyles = tv({
  base: "kern-card",
  variants: {
    background: {
      lavender: "bg-lavender-200",
      white: "bg-white",
    },
  },
  defaultVariants: {
    background: "lavender",
  },
});

interface Props extends VariantProps<typeof cardStyles> {
  title: string;
  headingLevel?: 2 | 3;
  target_option?: "_blank" | "_self";
  href?: string;
  preline?: string;
  body?: string;
  subline?: string;
  background?: "lavender" | "white";
  image?: ImageMetadata;
  imageAlt?: string | null;
  imageSource?: string;
  interactive?: boolean;
}

const {
  preline,
  title,
  headingLevel = 2,
  target_option = "_self",
  href,
  subline,
  body,
  background,
  image,
  imageAlt,
  imageSource,
  interactive = !!href,
} = Astro.props;

const Heading = `h${headingLevel}` as const;
const hasImage = Astro.slots.has("image") || (image && imageAlt !== undefined);
const hasIcon = Astro.slots.has("icon");
const hasFooter = Astro.slots.has("footer");
---

<article
  class={cardStyles({
    background,
    class: interactive ? "kern-card--interactive" : undefined,
  })}
>
  {hasImage && (
    <div class="kern-card__media relative">
      <slot name="image" />
      {image && imageAlt && (
        <Image
          src={image!}
          alt={imageAlt!}
          class="h-208 object-cover"
          densities={[1, 2]}
          width="382"
          height="208"
          quality={100}
        />
      )}
      {imageSource && (
        <p class="absolute right-0 bottom-0 w-auto! rounded-none! bg-black/40 px-4 text-xs text-white">
          Quelle: {imageSource}
        </p>
      )}
    </div>
  )}
  <div class="kern-card__container">
    <header class="kern-card__header">
      <slot name="pre-header" />
      {hasIcon && (
        <div class="mb-24" aria-hidden="true">
          <slot name="icon" />
        </div>
      )}
      <hgroup class="max-w-full">
        {preline && <p class="kern-preline">{preline}</p>}
        <Heading class="kern-title hyphens-auto wrap-break-word">
          {href ? (
            /* prettier-ignore */ <a href={href} class="kern-link--stretched" target={target_option}>{title}
              </a>
          ) : (
            title
          )}
        </Heading>
        {subline && <p class="kern-subline">{subline}</p>}
      </hgroup>
    </header>
    <section class="kern-card__body">
      {body && <p class="kern-body">{body}</p>}
      <slot />
    </section>
    {hasFooter && (
      <footer class="kern-card__footer">
        <slot name="footer" />
      </footer>
    )}
  </div>
</article>
